# ====================================================
# Zyntra Environment Configuration
# ====================================================

# ---------- Application ----------
APP_NAME=Zyntra
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
API_PREFIX=/api
API_VERSION=v1

# ---------- Security ----------
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
SESSION_TOKEN_TTL_MINUTES=10080

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://zyntra:zyntra@localhost:5432/zyntra
POSTGRES_USER=zyntra
POSTGRES_PASSWORD=zyntra
POSTGRES_DB=zyntra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- Storage ----------
S3_ENDPOINT=
S3_BUCKET=zyntra
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---------- Cloudflare R2 ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=

# ---------- Backblaze B2 ----------
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APPLICATION_KEY=
BACKBLAZE_B2_BUCKET=

# ---------- Azure Blob Storage ----------
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# ---------- Google Cloud Storage ----------
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ---------- Vector ----------
VECTOR_PROVIDER=pgvector
PGVECTOR_TABLE=embeddings

# ---------- OpenAI ----------
OPENAI_API_KEY=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=

# ---------- Gemini ----------
GOOGLE_API_KEY=

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=

# ---------- Groq ----------
GROQ_API_KEY=

# ---------- Fireworks ----------
FIREWORKS_API_KEY=

# ---------- Azure OpenAI ----------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ---------- AWS Bedrock ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=

# ---------- Logging ----------
LOG_LEVEL=INFO
SENTRY_DSN=

# ---------- Email ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@zyntra.dev
SENDBYTE_KEY=
SENDBYTE_API_URL=https://api.sendbyte.africa
EMAIL_ASSET_BASE_URL=http://localhost:8000/static/email

# ---------- OAuth ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------- GitLab ----------
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ---------- Bitbucket ----------
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ---------- Notion ----------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ---------- Google Drive ----------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# ---------- Dropbox ----------
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ---------- OneDrive ----------
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# ---------- Box ----------
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# ---------- Slack ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------- Microsoft ----------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ---------- Confluence ----------
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=

# ---------- GitBook ----------
GITBOOK_CLIENT_ID=
GITBOOK_CLIENT_SECRET=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CREDITS=

# ---------- Bachs ----------
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_PRODUCT_ID=

# ---------- Billing ----------
BILLING_CURRENCY=usd
BILLING_AUTO_TOP_UP_ENABLED=true

# ---------- Paddle ----------
PADDLE_API_KEY=

# ---------- LemonSqueezy ----------
LEMON_SQUEEZY_API_KEY=

# ---------- GitHub App ----------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# ---------- Monitoring ----------
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# ---------- Rate Limiting ----------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5

# ---------- Feature Flags ----------
ENABLE_MEMORY=true
ENABLE_RAG=true
ENABLE_ANALYTICS=true
ENABLE_TOOLS=true
ENABLE_ROUTER=true

# ---------- Webhook Security ----------
WEBHOOK_SIGNING_SECRET=

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://zyntry.space,https://zyntry.space,https://www.zyntry.space
FRONTEND_URL=http://localhost:3000

# ---------- Security Headers ----------
CSP_ENABLED=true
CSP_REPORT_URI=
SESSION_COOKIE_SECURE=false

# ---------- Encryption ----------
ENCRYPTION_KEY=

# ---------- Docker / Caddy ----------
CADDY_ADMIN_EMAIL=admin@zyntry.space

# Optional idempotent superadmin seed (API startup after migrations)
# Keep real credentials in .env or your deployment secret manager, never in Git.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Global API rate limit. Raise temporarily only for controlled capacity tests.
RATE_LIMIT_PER_MINUTE=60
DOMAIN=zyntry.space

# ---------- Docker Compose ----------
COMPOSE_PROJECT_NAME=zyntry
